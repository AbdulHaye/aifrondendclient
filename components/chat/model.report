<template>
  <div
    class="flex flex-col overflow-y-auto bg-white relative h-full border-r border-b bg-transparent"
  >
    <h5
      class="text-md font-semibold text-gray-700 text-center bg-white py-2 sticky top-0 z-20 bg-transparent"
    >
      {{ model }}
    </h5>
    <div class="relative flex-1 overflow-y-auto space-y-6 p-4">
      <MessageBubble
        v-for="(message, index) in messages"
        :key="message.id || index"
        :text="message.text"
        :timestamp="message.timestamp"
        :isUser="message.isUser"
        :isThinking="message.isThinking"
        :avatar="avatar"
        :messageId="message.id"
        :typing-speed="5"
        :initial-delay="50"
        :question="!message.isUser && index > 0 ? messages[index - 1].text : ''"
        :speakIsAudio="speakIsAudio"
        @feedback="$emit('feedback', $event)"
        @toggleSpeak="toggleSpeak"
        @refreshAnswer="refreshAnswer"
        @exportWord="exportWord"
        @exportPdf="exportPdf"
        @delete="deleteMessage"
      />
      <div v-if="!messages.length" class="text-gray-500 text-center">
        No messages yet for {{ model }}
      </div>
    </div>
  </div>
</template>

<script>
import MessageBubble from "./MessageBubble.vue";
import { ref } from "vue";

export default {
  name: "ModelChat",
  components: { MessageBubble },
  props: {
    model: { type: String, required: true },
    messages: { type: Array, required: true, default: () => [] },
    avatar: { type: String, required: true },
    speakIsAudio: { type: Boolean, default: false },
  },
  setup(props, { emit }) {
    const speakIsAudio = ref(props.speakIsAudio);

    const toggleSpeak = (text) => emit("toggleSpeak", text);
    const refreshAnswer = (question) => emit("refreshAnswer", question);
    const exportWord = (text) => emit("exportWord", text);
    const exportPdf = (text) => emit("exportPdf", text);
    const deleteMessage = (messageId) => emit("delete", messageId);

    return {
      speakIsAudio,
      toggleSpeak,
      refreshAnswer,
      exportWord,
      exportPdf,
      deleteMessage,
    };
  },
  mounted() {
    console.log(
      `ModelChat mounted for ${this.model}, messages:`,
      this.messages
    );
  },
  watch: {
    messages: {
      handler() {
        this.$nextTick(() => {
          this.$el.scrollTop = this.$el.scrollHeight;
        });
      },
      deep: true,
    },
  },
};
</script>

<style scoped>
.sticky {
  background: white;
}
</style>
