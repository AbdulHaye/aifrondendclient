<template>
  <div class="flex flex-col h-full bg-transparent">
    <div class="flex-1 flex overflow-hidden bg-white rounded-lg">
      <div v-if="isReady" class="w-full grid gap-4 overflow-hidden transition-all duration-300" :class="[
        focusedModel
          ? 'grid-cols-1'
          : selectedModels.length === 2
            ? 'grid-cols-2'
            : 'grid-cols-2 grid-rows-2',
      ]" style="grid-auto-rows: 1fr">
        <ModelChat v-for="model in selectedModels" :key="model.model_key" :model="model.model_name"
          :model-key="model.model_key" :messages="state.messages[model.model_key] || []" :avatar="state.avatar"
          :speak-is-audio="speakIsAudio" @click="setFocusedModel(model.model_key)" @feedback="handleFeedback"
          @toggle-speak="toggleSpeak" @refresh-answer="refreshAnswer" @export-word="exportWord" @export-pdf="exportPdf"
          @delete="deleteMessage" :class="{ hidden: focusedModel && focusedModel !== model.model_key }" />
      </div>
      <div v-else class="flex-1 flex items-center justify-center text-gray-500">
        Loading chat history...
      </div>
    </div>
    <div class="p-2 flex justify-center gap-2">
      <button v-if="focusedModel"
        class="bg-blue-500 text-white rounded px-4 py-2 hover:bg-blue-600 transition-colors z-10 flex items-center gap-2"
        @click="clearFocusedModel" aria-label="Back to Multi-Window View">
        Back to Multi-Window View
      </button>
      <button
        class="bg-red-500 text-white rounded px-4 py-2 hover:bg-red-600 transition-colors z-10 flex items-center gap-2"
        @click="emit('close')" aria-label="Close Multi-Window">
        Close
      </button>
    </div>
  </div>
</template>

<script setup>
import {
  ref,
  reactive,
  onMounted,
  onBeforeUnmount,
  nextTick,
  watch,
} from "vue";
import ModelChat from "./ModelChat.vue";
import { submitMessageReport } from "~/api/api"; // Adjust path as needed

const WS_URL = "wss://abdul.synthetixor.com/ws";

const props = defineProps({
  selectedModels: { type: Array, required: true, default: () => [] },
  userId: { type: [String, Number], default: null },
  speakIsAudio: { type: Boolean, default: false },
});

const emit = defineEmits([
  "toggle-speak",
  "refresh-answer",
  "export-word",
  "export-pdf",
  "delete-message",
  "feedback",
  "close",
  "update-session",
  "history-updated",
]);

const focusedModel = ref(null);
const isReady = ref(false);
const wsReady = ref(false);
const state = reactive({
  messages: {},
  avatar:
    "https://kdkhvabm.synthetixor.com/images/202501/22/qYID1kyTI0IOhwQOXeYR85jOl4JzZfJ5fCqPWH1D.png",
  chatSocket: null,
  currentSessionId: null,
  reconnectAttempts: 0,
  pingInterval: null,
});

const MAX_RECONNECT_ATTEMPTS = 5;
const PING_INTERVAL = 30000;

// Utility Functions
const generateMessageId = (prefix = "msg") =>
  `${prefix}_${Date.now()}_${Math.random().toString(36).substr(2, 5)}`;

const validateModels = (models) => {
  if (!Array.isArray(models) || models.length === 0) {
    console.error("Invalid selectedModels:", models);
    return false;
  }
  return models.every((model) => model.model_key && model.model_name);
};

const initializeMessages = (models) => {
  models.forEach((model) => {
    const modelKey = model.model_key;
    if (!state.messages[modelKey]) {
      state.messages[modelKey] = [
        {
          id: `init_${modelKey}_${Date.now()}`,
          text: `Hello! I'm ${model.model_name}, how can I assist you?`,
          isUser: false,
          timestamp: new Date(),
          sessionId: state.currentSessionId,
        },
      ];
    }
  });
};

// WebSocket Handlers
const handleWebSocketMessage = (message) => {
  if (message.type === "message") {
    const modelKey = message.model;
    if (state.messages[modelKey]) {
      state.messages[modelKey] = state.messages[modelKey].filter(
        (msg) => !msg.isThinking
      );
      const responseText = message.text?.trim();
      if (
        !responseText ||
        responseText === "undefined" ||
        responseText === "null"
      ) {
        state.messages[modelKey].push({
          id: generateMessageId("fallback"),
          text: "The system is busy, please try again later.",
          isUser: false,
          isThinking: false,
          timestamp: new Date(),
          sessionId: message.session_id || state.currentSessionId,
        });
      } else {
        state.messages[modelKey].push({
          id: message.message_id || generateMessageId("ai"),
          text: responseText,
          isUser: false,
          isThinking: false,
          timestamp: new Date(),
          sessionId: message.session_id || state.currentSessionId,
        });
      }
      updateSession(message.session_id);
      emit("history-updated", message.session_id);
    }
  } else if (message.type === "error") {
    console.error("WebSocket error for model:", message.model, "message:", message.message);
    handleErrorResponse(message.model, message.message);
  }
};

const handleErrorResponse = (
  modelKey,
  errorText = "The system is busy, please try again later."
) => {
  const targetModels = modelKey ? [modelKey] : Object.keys(state.messages);
  targetModels.forEach((key) => {
    if (state.messages[key]) {
      state.messages[key] = state.messages[key].filter(
        (msg) => !msg.isThinking
      );
      state.messages[key].push({
        id: generateMessageId("error"),
        text: errorText,
        isUser: false,
        isThinking: false,
        timestamp: new Date(),
        sessionId: state.currentSessionId,
      });
    }
  });
};

const updateSession = (sessionId) => {
  if (sessionId && sessionId !== state.currentSessionId) {
    state.currentSessionId = sessionId;
    emit("update-session", state.currentSessionId);
    emit("history-updated", sessionId);
  }
};

const connectWebSocket = () => {
  if (state.reconnectAttempts >= MAX_RECONNECT_ATTEMPTS) {
    console.error("Max reconnection attempts reached:", MAX_RECONNECT_ATTEMPTS);
    handleErrorResponse(
      null,
      "Unable to connect to server after multiple attempts"
    );
    return;
  }

  console.log(
    "Attempting WebSocket connection, attempt:",
    state.reconnectAttempts + 1
  );
  const chatSocket = new WebSocket(WS_URL);

  chatSocket.onopen = () => {
    console.log("WebSocket connected successfully");
    wsReady.value = true;
    state.reconnectAttempts = 0;
  };

  chatSocket.onmessage = (event) => {
    console.log("WebSocket message received:", event.data);
    try {
      const message = JSON.parse(event.data);
      handleWebSocketMessage(message);
    } catch (e) {
      console.error("Failed to parse WebSocket message:", e);
    }
  };

  chatSocket.onerror = (error) => {
    console.error("WebSocket error occurred:", error);
    wsReady.value = false;
  };

  chatSocket.onclose = (event) => {
    console.log("WebSocket closed:", {
      code: event.code,
      reason: event.reason,
    });
    wsReady.value = false;

    if (event.code !== 1000) {
      console.log("Unexpected closure, triggering reconnect");
      retryWebSocketConnection();
    } else {
      console.log("Normal closure, no reconnect attempted");
    }
  };

  state.chatSocket = chatSocket;
};

const retryWebSocketConnection = () => {
  state.reconnectAttempts++;
  const delay = Math.min(2000 * Math.pow(2, state.reconnectAttempts), 10000);
  console.log(
    `Scheduling reconnect in ${delay}ms, attempt ${state.reconnectAttempts}`
  );
  setTimeout(connectWebSocket, delay);
};

// Message Sending Functions
const sendMessage = async (text) => {
  if (!text?.trim()) {
    console.warn("Cannot send message: Text is empty");
    return;
  }

  const sessionId = state.currentSessionId || generateMessageId("sess");
  state.currentSessionId = sessionId;

  if (!wsReady.value || state.chatSocket.readyState !== WebSocket.OPEN) {
    console.warn("WebSocket not ready, attempting reconnect");
    connectWebSocket();
    await waitForWebSocket();
    if (!wsReady.value) {
      handleErrorResponse(null, "Unable to connect to server");
      return;
    }
  }

  props.selectedModels.forEach((model) => {
    sendToModel(text, model.model_key, sessionId);
  });
  emit("update-session", sessionId);
  emit("history-updated", sessionId);
};

const waitForWebSocket = () => {
  return new Promise((resolve) => {
    const interval = setInterval(() => {
      if (wsReady.value) {
        clearInterval(interval);
        resolve(true);
      }
    }, 500);
    setTimeout(() => {
      clearInterval(interval);
      resolve(false);
    }, 10000);
  });
};

const sendToModel = (text, modelKey, sessionId) => {
  if (!state.messages[modelKey]) state.messages[modelKey] = [];

  const userMessage = {
    id: generateMessageId("user"),
    text,
    isUser: true,
    timestamp: new Date(),
    sessionId,
  };
  state.messages[modelKey].push(userMessage);

  if (!state.chatSocket || state.chatSocket.readyState !== WebSocket.OPEN) {
    state.messages[modelKey].push({
      id: generateMessageId("error"),
      text: "The system is busy, please try again later.",
      isUser: false,
      isThinking: false,
      timestamp: new Date(),
      sessionId,
    });
    return;
  }

  const thinkingId = generateMessageId("thinking");
  state.messages[modelKey].push({
    id: thinkingId,
    text: "Thinking...",
    isUser: false,
    isThinking: true,
    timestamp: new Date(),
    sessionId,
  });

  const payload = {
    messages: [{ role: "user", content: text }],
    model: modelKey,
    userId: props.userId,
    session_id: sessionId,
    is_multi: true,
    type: "default",
  };
  console.log("Sending WebSocket payload:", payload);
  state.chatSocket.send(JSON.stringify(payload));

  setTimeout(() => {
    updateThinkingMessage(modelKey, thinkingId);
  }, 30000);
};

const updateThinkingMessage = (modelKey, thinkingId) => {
  if (
    state.messages[modelKey]?.some(
      (msg) => msg.id === thinkingId && msg.isThinking
    )
  ) {
    state.messages[modelKey] = state.messages[modelKey].map((msg) =>
      msg.id === thinkingId
        ? {
          ...msg,
          text: "The system is busy, please try again later.",
          isThinking: false,
        }
        : msg
    );
  }
};

const baseUrl = "https://abdul.synthetixor.com/api";

const loadHistory = async (sessionId) => {
  try {
    console.log("loadHistory called for session:", sessionId);
    const response = await check_message(sessionId);
    console.log("check_message response:", response);

    if (response.status === 200) {
      state.currentSessionId = sessionId;
      state.messages = {};

      response.data.forEach((msg) => {
        const modelKey = msg.model;
        if (!state.messages[modelKey]) {
          state.messages[modelKey] = [];
        }

        if (msg.question) {
          state.messages[modelKey].push({
            id: `${msg.id}-user`,
            text: msg.question,
            isUser: true,
            timestamp: new Date(msg.created_at),
            sessionId: msg.session_id,
          });
        }

        if (msg.message) {
          state.messages[modelKey].push({
            id: `${msg.id}-ai`,
            text: msg.message,
            isUser: false,
            timestamp: new Date(msg.created_at),
            sessionId: msg.session_id,
          });
        }
      });

      props.selectedModels.forEach((model) => {
        if (!state.messages[model.model_key]) {
          state.messages[model.model_key] = [];
        }
      });

      console.log("Messages loaded:", state.messages);
      isReady.value = true;
      emit("history-updated", sessionId);
    } else {
      throw new Error("Failed to load history");
    }
  } catch (error) {
    console.error("Error loading history:", error);
    isReady.value = true;
  }
};

const check_message = async (sessionId) => {
  const response = await fetch(`${baseUrl}/check_message`, {
    method: "POST",
    headers: {
      Authorization: `Bearer ${useCookie("token")?.value}`,
      "Content-Type": "application/json",
    },
    body: JSON.stringify({ session_id: sessionId }),
  });

  if (!response.ok) {
    throw new Error(`HTTP error! Status: ${response.status}`);
  }

  return await response.json();
};

// Feedback Handler
const handleFeedback = async (data) => {
  try {
    const reportData = {
      reportable_id: data.reportableId,
      reportable_type: data.reportableType || 'Message',
      ai_function: data.aiFunction || 'text',
      user_id: props.userId || null,
      report_type: data.type,
      issue_category: data.issueType || null,
      reason: data.text || 'No reason provided',
    };
    console.log("Submitting feedback:", reportData);
    const response = await submitMessageReport(reportData);
    if (response.success) {
      alert("Feedback submitted successfully");
      console.log("Feedback submitted successfully:", response);
    } else {
      throw new Error("Failed to submit feedback");
    }
  } catch (error) {
    console.error("Error submitting feedback:", error);
    alert("Failed to submit feedback: " + error.message);
  }
};

// Lifecycle Hooks
onMounted(async () => {
  console.log("MultiWindowChat mounted");

  if (!validateModels(props.selectedModels)) return;
  initializeMessages(props.selectedModels);
  await nextTick();
  isReady.value = true;
  connectWebSocket();
});

onBeforeUnmount(() => {
  if (state.chatSocket?.readyState === WebSocket.OPEN) {
    state.chatSocket.close(1000, "Component unmounted");
  }
  if (state.pingInterval) {
    clearInterval(state.pingInterval);
  }
});

watch(
  () => props.selectedModels,
  (newModels) => {
    if (!validateModels(newModels)) return;
    initializeMessages(newModels);
  },
  { deep: true }
);

// Event Handlers
const setFocusedModel = (modelKey) => {
  focusedModel.value = modelKey;
};
const clearFocusedModel = () => {
  focusedModel.value = null;
};
const toggleSpeak = (text) => emit("toggle-speak", text);
const refreshAnswer = (question) => emit("refresh-answer", question);
const exportWord = (text) => emit("export-word", text);
const exportPdf = (text) => emit("export-pdf", text);
const deleteMessage = (messageId) => emit("delete-message", messageId);

defineExpose({ sendMessage, loadHistory });
</script>

<style scoped>
.grid>div {
  @apply border border-gray-200 rounded-md;
}

.hidden {
  @apply opacity-0 pointer-events-none absolute;
}

.grid {
  @apply w-full h-full;
}
</style>